# Solo servidor. Configurar como variables privadas en Vercel; nunca VITE_ ni NEXT_PUBLIC_.
TURSO_DATABASE_URL=libsql://nombre-de-la-base-organizacion.turso.io
TURSO_AUTH_TOKEN=reemplazar-con-el-token-de-la-base
# Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TALLER_SETUP_KEY=reemplazar-con-una-clave-aleatoria-de-al-menos-24-caracteres
